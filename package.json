{
  "name": "project-remotion-investigation-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Project ReMotion – browser-based investigation portal for the failure of an AI-assisted rehabilitation robot (AWE Exercise 2).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfonso-dv/awb_exercise1_devera.git"
  },
  "author": "Anton Miguel de Vera",
